<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@id/statistics_parent_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@id/top_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_toStartOf="@id/btn_more"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@id/statistics_tabs"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@color/white"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="5dp">

                <TextView
                    android:id="@id/normal_bill_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="35dp"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="日常"
                    android:textSize="14sp" />

                <TextView
                    android:id="@id/month_bill_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="35dp"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="月统计"
                    android:textSize="14sp" />

                <TextView
                    android:id="@id/year_bill_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="35dp"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="年统计"
                    android:textSize="14sp" />

                <TextView
                    android:id="@id/self_bill_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="35dp"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:text="自定义"
                    android:textSize="14sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <ImageView
            android:id="@id/btn_more"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_alignParentEnd="true"
            android:background="@drawable/selectable_item_circle"
            android:padding="15dp"
            android:src="@mipmap/ic_menu"
            android:tint="@color/textColorPrimary" />
    </RelativeLayout>

    <FrameLayout
        android:id="@id/statistics_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
