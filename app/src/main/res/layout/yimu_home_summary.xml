<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.nonen.Bookkeeping.ui.components.YimuNativeSummaryBackground
        android:id="@+id/home_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:background="@mipmap/bg_main"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="15dp"
        android:paddingEnd="15dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/month_income_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/month_income_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingEnd="35dp"
                    android:singleLine="true"
                    android:text="@string/yimu_month_income"
                    android:textSize="12sp" />
                <TextView
                    android:id="@id/month_income"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:paddingEnd="25dp"
                    android:singleLine="true"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/month_balance_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/month_balance_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingEnd="35dp"
                    android:singleLine="true"
                    android:text="@string/yimu_month_balance"
                    android:textSize="12sp" />
                <TextView
                    android:id="@id/month_balance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:paddingEnd="25dp"
                    android:singleLine="true"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/budget_setting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/month_budget_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:text="@string/yimu_month_budget"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/month_budget"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:singleLine="true"
                    android:text="@string/yimu_set_budget"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/month_pay_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/month_pay_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/yimu_month_expense"
                android:textSize="12sp" />
            <TextView
                android:id="@id/month_pay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textSize="25dp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.nonen.Bookkeeping.ui.components.YimuNativeSummaryBackground>

    <LinearLayout
        android:id="@id/add_bill_btn"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:layout_marginTop="15dp"
        android:background="@drawable/selectable_item_primary_background"
        android:gravity="center"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/add_bill_icon"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@mipmap/ic_add_bill" />
        <TextView
            android:id="@+id/add_bill_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/yimu_add_new"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
