  "business_rules": {
    "bill": {
      "entity": "com.wangc.bill.database.entity.Bill",
      "action_class": "com.wangc.bill.database.action.a0",
      "activity": "com.wangc.bill.activity.AddBillActivity",
      "save_method": {
        "signature": "h(com.wangc.bill.database.entity.Bill): int",
        "evidence_id": "ev_0641673ac597f98f7fb37701fe65d9e0c24f2cb9a1f9be429d18138d51de13c4"
      },
      "asset_sync_method": {
        "signature": "s1(com.wangc.bill.database.entity.Bill): void",
        "evidence_id": "ev_4e4728f40ec7e3d00f5916badb89047dc803880b9db4dc95f923e157607a6830"
      },
      "delete_method": {
        "signature": "r(com.wangc.bill.database.entity.Bill, boolean): void",
        "evidence_id": "ev_21b4a12be0b8d2b92933ebbd263d8d1906e99a385d739f0c617805dff84090e6"
      },
      "balance_formula": {
        "income": "asset.assetNumber += Math.abs(bill.getCurrencyCost()) + refundedAmount",
        "expense": "asset.assetNumber -= (Math.abs(bill.getCurrencyCost()) + refundedAmount)",
        "edit_rollback": "if old was income: assetOld.reduceNumber(oldCost); else assetOld.addNumber(oldCost)",
        "edit_apply": "if new is income: assetNew.addNumber(newCost); else assetNew.reduceNumber(newCost)"
      },
      "statistics_rules": {
        "not_into_budget_field": "notIntoBudget",
        "not_into_total_field": "notIntoTotal",
        "income_parent_id": 9
      }
    },
    "transfer": {
      "entity": "com.wangc.bill.database.entity.Transfer",
      "action_class": "com.wangc.bill.database.action.u2",
      "activity": "com.wangc.bill.activity.asset.TransferAddActivity",
