        "evidence_id": "ev_67f2f18a07a0683410bd974e947ad8d820f7c2d87431db5940d75ee79706d55e"
      },
      "balance_formula": {
        "out_account": "fromAsset.reduceNumber(cost)",
        "in_account": "toAsset.addNumber(toCost)",
        "currency_rate_formula": "toCost = g2.q((amount * s0.i(fromCurrency)) / s0.i(toCurrency))",
        "service_charge": "if serviceCharge > 0: generates Bill (billType = 1, cost = serviceCharge, assetId = fromAssetId, remark = fromAssetName + \" 转账手续费\")"
      }
